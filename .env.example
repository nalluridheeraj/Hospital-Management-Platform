# ==============================================================================
# Environment Configuration - Hospital Management Platform
# Copy this file to .env and adjust variables for your target environment.
# DO NOT commit the resulting .env file into version control!
# ==============================================================================

# Application Settings
ENVIRONMENT=production
APP_NAME="Hospital Appointment Scheduling API"
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & Authentication (Generate secure secret: openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Settings
# For Docker Compose / Production PostgreSQL:
DATABASE_URL=postgresql://app_user:app_secure_password_replace_me@db:5432/hospital_db
# For Local Testing / SQLite fallback (optional):
# DATABASE_URL=sqlite:///./hospital.db

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_secure_password_replace_me
POSTGRES_DB=hospital_db
POSTGRES_PORT=5432

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://localhost,http://localhost,http://127.0.0.1:8000

# Rate Limiting & Concurrency Controls
MAX_CONCURRENT_REQUESTS=100
SLOT_LOCK_TIMEOUT_SECONDS=5

# Audit Logging
AUDIT_LOG_ENABLED=true

